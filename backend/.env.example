# Copy to backend/.env and configure secrets outside source control.

# Persistent career platform data (relative paths resolve from the repository root).
JOB_DATABASE_PATH=backend/data/job-intelligence.sqlite3

# Required before storing resumes, preferences, private descriptions, notes, or reminders.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store in a secret manager and retain stable backups; losing the key makes encrypted data unreadable.
JOB_DATA_ENCRYPTION_KEY=

# Optional deterministic score weights (relative; active factors are normalized).
JOB_MATCH_WEIGHT_SKILLS=0.40
JOB_MATCH_WEIGHT_EXPERIENCE=0.20
JOB_MATCH_WEIGHT_RESPONSIBILITIES=0.15
JOB_MATCH_WEIGHT_EDUCATION=0.10
JOB_MATCH_WEIGHT_CERTIFICATIONS=0.05
JOB_MATCH_WEIGHT_KEYWORDS=0.10
JOB_MATCH_WEIGHT_LOCATION=0.05

# Optional Adzuna integration. Enable only after verifying your current commercial rights,
# country coverage, pricing, quotas, and provider terms.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COMMERCIAL_USE_CONFIRMED=false
ADZUNA_COUNTRIES=gb
ADZUNA_MIN_INTERVAL_SECONDS=1
JOB_SEARCH_CACHE_SECONDS=600

# Employer-specific Greenhouse / Lever board feeds. Configure only when authorized by the employer.
CAREER_BOARD_PERMISSION_CONFIRMED=false
GREENHOUSE_BOARD_TOKENS=
LEVER_SITE_NAMES=
COMPANY_BOARD_MIN_INTERVAL_SECONDS=1

# Optional SMTP for user-requested reminder emails. No employer emails are sent by the platform.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional AI resume writing. The API key remains on the backend and is used only
# when a user explicitly requests AI generation or job-targeted optimization.
RESUME_AI_API_KEY=
RESUME_AI_MODEL=gpt-4o-mini
RESUME_AI_TIMEOUT_SECONDS=45

# Business module: configure only after opening and verifying the merchant account.
# Razorpay credentials stay on the backend; the key ID is public checkout metadata.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe credentials stay on the backend. Configure trusted frontend return URLs
# before enabling Stripe Checkout; use test-mode credentials until launch approval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth sign-in (ID token verification) requires only the client ID on the backend.
# GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI are optional and mainly relevant for a server-side OAuth code flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

BUSINESS_CHECKOUT_SUCCESS_URL=http://localhost:5173/?business_checkout_session={CHECKOUT_SESSION_ID}
BUSINESS_CHECKOUT_CANCEL_URL=http://localhost:5173/?business_checkout_cancelled=1

# Comma-separated existing account emails permitted to access business administration.
BUSINESS_ADMIN_EMAILS=
