# Resume ATS Score Checker - Environment Configuration Example
# Copy to .env.local for local overrides

# Backend API Base URL
# Leave empty or set to http://127.0.0.1:8000 for local development
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Google Identity Services client ID for the Career Platform sign-in flow.
# Keep the client secret on the backend only; do not expose it in the browser.
VITE_GOOGLE_CLIENT_ID=

